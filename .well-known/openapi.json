{
  "openapi": "3.0.0",
  "info": {
    "title": "The Billions Architect API",
    "version": "1.0.0",
    "description": "AI agent for reasoning, analytics, and Billions ecosystem queries"
  },
  "servers": [
    {
      "url": "https://verified-agent-identity-4iw5.vercel.app"
    }
  ],
  "paths": {
    "/api/architect": {
      "get": {
        "operationId": "getMetadata",
        "summary": "Get agent metadata",
        "responses": {
          "200": {
            "description": "Agent metadata"
          }
        }
      },
      "post": {
        "operationId": "executeAgent",
        "summary": "Execute agent actions",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "action": {
                    "type": "string"
                  },
                  "input": {
                    "type": "string"
                  }
                },
                "required": ["action"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    }
  }
}
