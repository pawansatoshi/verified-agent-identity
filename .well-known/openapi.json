{
  "openapi": "3.0.0",
  "info": {
    "title": "The Billions Architect API",
    "version": "2.1",
    "description": "AI agent for reasoning, analytics, and Billions ecosystem queries"
  },
  "servers": [
    {
      "url": "https://verified-agent-identity-4iw5.vercel.app"
    }
  ],
  "paths": {
    "/api/architect": {
      "get": {
        "summary": "Get agent metadata",
        "operationId": "getMetadata",
        "responses": {
          "200": {
            "description": "Agent metadata response"
          }
        }
      },
      "post": {
        "summary": "Execute agent action",
        "operationId": "executeAgent",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "action": {
                    "type": "string"
                  },
                  "input": {
                    "type": "string"
                  }
                },
                "required": ["action"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "action": { "type": "string" },
                    "input": { "type": "string" },
                    "result": { "type": "object" },
                    "metadata": { "type": "object" },
                    "timestamp": { "type": "number" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
